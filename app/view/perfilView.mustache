<link rel="stylesheet" href="/css/inicio.css">
<link rel="stylesheet" href="/css/perfil.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<main class="perfil-contenedor">

    <!-- ===== CABECERA / HERO DEL PERFIL ===== -->
    <section class="perfil-hero-card">
        <div class="perfil-hero-izq">
            <div class="perfil-avatar-wrap">
                {{#tieneFoto}}
                    <img class="perfil-avatar-img" src="{{foto_perfil}}" alt="Foto de perfil de {{nombre_usuario}}">
                {{/tieneFoto}}
                {{^tieneFoto}}
                    <div class="perfil-avatar-placeholder" aria-hidden="true">{{inicial}}</div>
                {{/tieneFoto}}
            </div>

            <div class="perfil-hero-datos">
                <h1>{{nombre_completo}}</h1>
                <span class="perfil-username">@{{nombre_usuario}}</span>

                <div class="perfil-badges">
                    <span class="perfil-badge badge-nivel">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                            <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26"/>
                        </svg>
                        Nivel {{nivel}}
                    </span>

                    {{#pais}}
                    <span class="perfil-badge badge-ubicacion">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        {{ciudad}}{{#ciudad}}{{#pais}}, {{/pais}}{{/ciudad}}{{pais}}
                    </span>
                    {{/pais}}

                    <span class="perfil-badge badge-registro">
                        Miembro desde {{fecha_registro}}
                    </span>
                </div>
            </div>
        </div>

        <div>
            <a href="/inicio/show" class="boton-jugar-perfil">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                    <path d="M7 4.5v15a1 1 0 0 0 1.5.9l12-7.5a1 1 0 0 0 0-1.8l-12-7.5A1 1 0 0 0 7 4.5z"/>
                </svg>
                Jugar partida
            </a>
        </div>
    </section>

    <!-- ===== RESUMEN DE TOTALES (PARTIDAS Y PUNTAJE) ===== -->
    <section class="perfil-totales-fila" aria-label="Totales acumulados">
        <!-- Puntaje Acumulado -->
        <article class="tarjeta-total">
            <div class="total-icono-wrap total-icono-puntaje" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
                    <polygon points="12,2.5 14.47,9.1 21.51,9.41 15.99,13.8 17.88,20.59 12,16.7 6.12,20.59 8.01,13.8 2.49,9.41 9.53,9.1"/>
                </svg>
            </div>
            <div class="total-info">
                <h3>Puntaje acumulado</h3>
                <p class="total-valor">{{puntajeAcumulado}} <span class="total-subtexto">puntos</span></p>
            </div>
        </article>

        <!-- Total de Partidas Finalizadas -->
        <article class="tarjeta-total">
            <div class="total-icono-wrap total-icono-partidas" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                    <path d="M7 6.5h10a5 5 0 0 1 4.9 4l.9 4.4a3 3 0 0 1-5.2 2.5L15.4 15.5H8.6l-2.2 1.9a3 3 0 0 1-5.2-2.5l.9-4.4A5 5 0 0 1 7 6.5z"/>
                    <path fill="#ffffff" d="M7.2 9.3h1.4v1.4H10v1.4H8.6v1.4H7.2v-1.4H5.8v-1.4h1.4V9.3z"/>
                    <circle fill="#ffffff" cx="15.6" cy="10" r="1.1"/>
                    <circle fill="#ffffff" cx="18.2" cy="12.2" r="1.1"/>
                </svg>
            </div>
            <div class="total-info">
                <h3>Total de partidas</h3>
                <p class="total-valor">{{totalPartidas}} <span class="total-subtexto">finalizadas</span></p>
            </div>
        </article>
    </section>

    <!-- ===== CUERPO PRINCIPAL (DATOS + MAPA / HISTORIAL) ===== -->
    <div class="perfil-grid-cuerpo">

        <!-- COLUMNA IZQUIERDA: DATOS VISIBLES + MAPA -->
        <aside>
            <!-- Datos de la cuenta -->
            <section class="perfil-card">
                <div class="perfil-card-cabecera">
                    <h2>
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        Datos de la cuenta
                    </h2>
                </div>

                <div class="datos-lista">
                    <div class="dato-fila">
                        <span class="dato-etiqueta">Nombre completo</span>
                        <span class="dato-valor">{{nombre_completo}}</span>
                    </div>

                    <div class="dato-fila">
                        <span class="dato-etiqueta">Usuario</span>
                        <span class="dato-valor">@{{nombre_usuario}}</span>
                    </div>

                    <div class="dato-fila">
                        <span class="dato-etiqueta">Correo electrónico</span>
                        <span class="dato-valor">{{email}}</span>
                    </div>

                    <div class="dato-fila">
                        <span class="dato-etiqueta">Sexo</span>
                        <span class="dato-valor">{{sexo}}</span>
                    </div>

                    <div class="dato-fila">
                        <span class="dato-etiqueta">Año de nacimiento</span>
                        <span class="dato-valor">{{anio_nacimiento}}</span>
                    </div>

                    <div class="dato-fila">
                        <span class="dato-etiqueta">País</span>
                        <span class="dato-valor">{{pais}}</span>
                    </div>

                    <div class="dato-fila">
                        <span class="dato-etiqueta">Ciudad</span>
                        <span class="dato-valor">{{ciudad}}</span>
                    </div>

                    <div class="dato-fila">
                        <span class="dato-etiqueta">Nivel</span>
                        <span class="dato-valor">{{nivel}}</span>
                    </div>
                </div>
            </section>

            <!-- Ubicación en el mapa -->
            <section class="perfil-card">
                <div class="perfil-card-cabecera">
                    <h2>
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                            <line x1="8" y1="2" x2="8" y2="18"></line>
                            <line x1="16" y1="6" x2="16" y2="22"></line>
                        </svg>
                        Ubicación registrada
                    </h2>
                </div>

                <div class="mapa-wrap">
                    <div id="mapa-perfil" role="region" aria-label="Mapa de ubicación del usuario"></div>
                    <div class="mapa-pie">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>{{ciudad}}{{#ciudad}}{{#pais}}, {{/pais}}{{/ciudad}}{{pais}}</span>
                    </div>
                </div>
            </section>
        </aside>

        <!-- COLUMNA DERECHA: HISTORIAL DE PARTIDAS FINALIZADAS -->
        <section class="perfil-card">
            <div class="perfil-card-cabecera">
                <h2>
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    Historial de partidas finalizadas
                </h2>
                {{#tienePartidas}}
                    <span class="perfil-badge badge-registro">{{totalPartidas}} partidas</span>
                {{/tienePartidas}}
            </div>

            {{#tienePartidas}}
            <div class="tabla-wrap">
                <table class="tabla-partidas" aria-label="Historial de partidas finalizadas">
                    <thead>
                        <tr>
                            <th scope="col">Partida</th>
                            <th scope="col">Fecha</th>
                            <th scope="col">Resultado</th>
                            <th scope="col">Puntaje</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#partidas}}
                        <tr>
                            <td>#{{numero}}</td>
                            <td>{{fecha}}</td>
                            <td><span class="badge-resultado">{{resultado}}</span></td>
                            <td>{{puntaje}} pts</td>
                        </tr>
                        {{/partidas}}
                    </tbody>
                </table>
            </div>
            {{/tienePartidas}}

            {{^tienePartidas}}
            <div class="mensaje-vacio-perfil" role="status">
                <div class="mensaje-vacio-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="8" y1="15" x2="16" y2="15"></line>
                        <line x1="9" y1="9" x2="9.01" y2="9"></line>
                        <line x1="15" y1="9" x2="15.01" y2="9"></line>
                    </svg>
                </div>
                <p class="mensaje-vacio-texto">Todavía no tenes partidas finalizadas</p>
                <a href="/inicio/show" class="boton-jugar-perfil">Comenzar a jugar</a>
            </div>
            {{/tienePartidas}}
        </section>

    </div>

</main>

<script>
document.addEventListener("DOMContentLoaded", function () {
    var mapaElemento = document.getElementById("mapa-perfil");
    if (!mapaElemento) return;

    var tieneCoords = {{#tieneCoordenadas}}true{{/tieneCoordenadas}}{{^tieneCoordenadas}}false{{/tieneCoordenadas}};
    var lat = {{#latitud}}{{latitud}}{{/latitud}}{{^latitud}}null{{/latitud}};
    var lng = {{#longitud}}{{longitud}}{{/longitud}}{{^longitud}}null{{/longitud}};
    var usuario = "{{nombre_usuario}}";
    var ciudad = "{{ciudad}}";
    var pais = "{{pais}}";

    var latCentro = (tieneCoords && lat !== null) ? parseFloat(lat) : -34.6037;
    var lngCentro = (tieneCoords && lng !== null) ? parseFloat(lng) : -58.3816;
    var zoomInicial = tieneCoords ? 12 : 4;

    var map = L.map("mapa-perfil", {
        scrollWheelZoom: false
    }).setView([latCentro, lngCentro], zoomInicial);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
    }).addTo(map);

    if (tieneCoords) {
        var marker = L.marker([latCentro, lngCentro]).addTo(map);
        var ubicacionTexto = ciudad + (ciudad && pais ? ", " : "") + pais;
        var popupHtml = '<div style="text-align: center; font-family: inherit; font-size: 13px;">' +
            '<strong>@' + usuario + '</strong>' +
            (ubicacionTexto ? '<br><span>' + ubicacionTexto + '</span>' : '') +
            '</div>';
        marker.bindPopup(popupHtml).openPopup();
    }

    setTimeout(function () {
        map.invalidateSize();
    }, 250);

    window.addEventListener("temaCambiado", function () {
        setTimeout(function () {
            map.invalidateSize();
        }, 100);
    });

    window.addEventListener("resize", function () {
        map.invalidateSize();
    });
});
</script>
