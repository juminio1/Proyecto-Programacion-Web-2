<link rel="stylesheet" href="/css/partida.css?v=temporizador15">
<link rel="stylesheet" href="/css/partida.css?v=animaciones2">

<main class="partida-pagina" data-id-partida="{{idPartida}}">
    <form class="partida-formulario-salida"
          method="post"
          action="/partida/abandonar">
        <input type="hidden" name="id_partida" value="{{idPartida}}">

        <button type="submit" class="partida-volver">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 12H5m6-6-6 6 6 6"/>
            </svg>
            Volver al inicio
        </button>
    </form>

    <div class="partida-encabezado">
        <h1>Partida en curso</h1>
        <p>¡Elegí la respuesta correcta!</p>
    </div>

    <div class="partida-columnas">
        <section class="partida-tarjeta partida-pregunta animar"
                 style="--color-categoria: {{colorCategoria}};"
                 aria-labelledby="partida-enunciado">

            <div class="partida-pregunta-datos">
                <span class="partida-globo" aria-hidden="true">
                    <svg viewBox="0 0 48 48">
                        <circle cx="24" cy="24" r="21" fill="#2c91e8"/>
                        <path d="M13 7l10-3 7 4-4 6-8 1-1 6-8-3-4 2 2-9z
                                 M29 22l9-5 6 8-5 8-5 9-8-4 2-7-5-4z
                                 M10 28l8-3 5 5-3 9-5-2z"
                              fill="#68c97b"/>
                        <path d="M12 10c-5 8-5 18 1 26"
                              fill="none" stroke="#ffffff"
                              stroke-opacity=".3" stroke-width="3"
                              stroke-linecap="round"/>
                    </svg>
                </span>

                <span class="partida-categoria">{{categoria}}</span>
                <span class="partida-numero">Pregunta {{numeroPregunta}}</span>
            </div>

            <h2 id="partida-enunciado">{{pregunta}}</h2>

            <form id="partida-formulario" method="post" action="/partida/responder">
                <input type="hidden" name="id_pregunta" id="partida-id-pregunta" value="{{idPregunta}}">
                <input type="hidden" name="id_asignacion" id="partida-id-asignacion" value="{{idAsignacion}}">

                <fieldset class="partida-opciones"
                          aria-describedby="partida-mensaje">
                    <legend class="partida-solo-lectores">
                        Elegí una respuesta
                    </legend>

                    {{#opciones}}
                        <label class="partida-opcion">
                            <input class="partida-radio"
                                   type="radio"
                                   name="respuesta"
                                   value="{{id}}"
                                   data-texto="{{texto}}"
                                   required>

                            <span class="partida-opcion-contenido">
                                <span class="partida-letra" aria-hidden="true">
                                    {{letra}}
                                </span>
                                <span class="partida-opcion-texto">
                                    {{texto}}
                                </span>
                            </span>
                        </label>
                    {{/opciones}}
                </fieldset>

                <p id="partida-mensaje"
                   class="partida-mensaje"
                   role="status"
                   aria-live="polite">
                    Seleccioná una opción para responder.
                </p>

                <button class="partida-confirmar"
                        type="submit"
                        disabled>
                    Confirmar respuesta
                </button>
            </form>
            <div class="partida-reporte">
                <button type="button"
                        class="partida-reporte-abrir"
                        id="partida-reporte-abrir"
                        aria-expanded="false"
                        aria-controls="partida-reporte-formulario">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 21V4m0 0h11l-2 4 2 4H5"/>
                    </svg>
                    Reportar pregunta
                </button>

                <form id="partida-reporte-formulario"
                      class="partida-reporte-formulario"
                      method="post"
                      action="/partida/reportar"
                      hidden>
                    <label for="partida-reporte-motivo">
                        ¿Qué problema tiene esta pregunta? (opcional)
                    </label>
                    <textarea id="partida-reporte-motivo"
                              name="motivo"
                              maxlength="255"
                              rows="2"></textarea>

                    <div class="partida-reporte-acciones">
                        <button type="submit" class="partida-reporte-enviar">Enviar reporte</button>
                        <button type="button" class="partida-reporte-cancelar" id="partida-reporte-cancelar">Cancelar</button>
                    </div>
                </form>

                <p id="partida-reporte-mensaje"
                   class="partida-reporte-mensaje"
                   role="status"
                   aria-live="polite"
                   hidden></p>
            </div>
        </section>

        <aside class="partida-tarjeta partida-resumen"
               aria-labelledby="partida-resumen-titulo">

            <h2 id="partida-resumen-titulo">Tu partida</h2>

            <div class="partida-tiempo">
                <p class="partida-tiempo-etiqueta">Tiempo restante</p>

                <div class="partida-reloj"
                     id="partida-reloj"
                     data-restante-ms="{{tiempoRestanteMs}}"
                     data-duracion-ms="{{duracionPreguntaMs}}"
                     role="img"
                     aria-label="{{tiempoRestante}} segundos restantes">
                    <svg viewBox="0 0 160 160" aria-hidden="true">
                        <circle class="partida-reloj-fondo"
                                cx="80" cy="80" r="68"/>
                        <circle class="partida-reloj-progreso"
                                cx="80" cy="80" r="68" pathLength="100"/>
                    </svg>

                    <div class="partida-reloj-texto" aria-hidden="true">
                        <strong>{{tiempoRestante}}</strong>
                        <span>segundos</span>
                    </div>
                </div>
            </div>

            <div class="partida-estadisticas">
                <div class="partida-dato">
                    <span class="partida-dato-icono partida-icono-puntaje"
                          aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8
                                     -6.2-3.3-6.2 3.3L7 14.2 2 9.3l6.9-1z"/>
                        </svg>
                    </span>

                    <div>
                        <p class="partida-dato-etiqueta">Puntaje</p>
                        <p class="partida-dato-valor" id="partida-puntaje-valor">{{puntaje}} puntos</p>
                    </div>
                </div>

                <div class="partida-dato">
                    <span class="partida-dato-icono partida-icono-aciertos"
                          aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <path d="m5 12 4 4L19 6"/>
                        </svg>
                    </span>

                    <div>
                        <p class="partida-dato-etiqueta">Respuestas correctas</p>
                        <p class="partida-dato-valor" id="partida-aciertos-valor">{{respuestasCorrectas}}</p>
                    </div>
                </div>
            </div>

            <form class="partida-formulario-salida partida-formulario-abandonar"
                  method="post"
                  action="/partida/abandonar">
                <input type="hidden" name="id_partida" value="{{idPartida}}">

                <button type="submit" class="partida-abandonar">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 4h8v16h-8m-6-8h10m-4-4 4 4-4 4"/>
                    </svg>
                    Abandonar partida
                </button>
            </form>
        </aside>
    </div>
    <dialog id="partida-confirmar-abandono" class="partida-modal"
            aria-labelledby="partida-abandono-titulo" aria-describedby="partida-abandono-aviso">
        <h2 id="partida-abandono-titulo">¿Abandonar la partida?</h2>
        <p id="partida-abandono-aviso" class="partida-modal-descripcion">
            Esta partida quedará con 0 puntos. El reloj sigue corriendo.
        </p>
        <form method="dialog" class="w3-section">
            <button type="submit" value="seguir" class="w3-button w3-round-large w3-light-grey" autofocus>
                Seguir jugando
            </button>
            <button type="submit" value="abandonar" class="w3-button w3-round-large w3-deep-purple">
                Confirmar abandono
            </button>
        </form>
    </dialog>
</main>

<script src="/js/partida.js?v=abandono1" defer></script>
<script src="/js/reporte-pregunta.js?v=1" defer></script>