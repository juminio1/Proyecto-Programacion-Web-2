<style>
    .pt-panel {
        --pt-ink: #21183e;
        --pt-muted: #635a77;
        --pt-border: #e8e1f1;
        --pt-purple: #5b2fd2;
        max-width: 1160px;
        margin: 0 auto;
        padding: clamp(18px, 4vw, 42px) clamp(14px, 3.5vw, 32px) 52px;
        color: var(--pt-ink);
        font-family: "Nunito", system-ui, sans-serif;
        line-height: 1.5;
    }

    .pt-panel *, .pt-panel *::before, .pt-panel *::after { box-sizing: border-box; }
    .pt-panel [hidden] { display: none !important; }
    .pt-panel :is(a, button, input):focus-visible { outline: 3px solid #9a79ec; outline-offset: 3px; }
    .pt-panel :is(h1, h2, h3, p) { margin: 0; font-family: inherit; }

    .pt-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        padding: clamp(24px, 5vw, 54px);
        border-radius: 26px;
        background: radial-gradient(ellipse at 100% 0%, #7447dc 0%, transparent 57%),
        linear-gradient(125deg, #241348, #42219a 85%);
        color: #fff;
        box-shadow: 0 12px 30px #32146e24;
    }

    .pt-hero::before, .pt-hero::after {
        position: absolute;
        z-index: -1;
        inset: -220px -105px auto auto;
        width: 480px;
        height: 480px;
        border: 1px solid #ffffff29;
        border-radius: 50%;
        content: "";
    }

    .pt-hero::after { inset: -183px -68px auto auto; width: 405px; height: 405px; }

    .pt-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #eee5ff;
    }

    .pt-kicker span { width: 8px; height: 8px; border-radius: 50%; background: #c8a9ff; }

    .pt-hero h1 {
        margin: 9px 0 10px;
        font-size: clamp(2rem, 5vw, 3.55rem);
        line-height: 1.07;
        font-weight: 850;
        letter-spacing: -.045em;
    }

    .pt-bajada { max-width: 500px; color: #f3ecff; font-size: 1rem; }

    .pt-tablero {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 45px;
        margin-top: 22px;
        padding: 9px 15px;
        border-radius: 11px;
        color: #47229c;
        background: #fff;
        font-size: .875rem;
        font-weight: 800;
        text-decoration: none;
    }

    .pt-tablero:hover { background: #f1e8ff; }

    .pt-hero-datos { display: flex; gap: 10px; }
    .pt-hero-datos div {
        min-width: 90px;
        padding: 9px 13px;
        border: 1px solid #ffffff43;
        border-radius: 13px;
        background: #ffffff16;
        text-align: center;
    }
    .pt-hero-datos strong, .pt-hero-datos span { display: block; }
    .pt-hero-datos strong { font-size: 1.55rem; line-height: 1.2; }
    .pt-hero-datos span { color: #efe5ff; font-size: .78rem; }

    .pt-controles {
        margin: 24px 0 26px;
        padding: 18px 22px;
        border: 1px solid var(--pt-border);
        border-radius: 18px;
        background: #fff;
    }
    .pt-controles-cabecera { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; }
    .pt-controles h2 { font-size: 1.35rem; font-weight: 850; letter-spacing: -.025em; }
    .pt-conteo { color: var(--pt-muted); font-size: .86rem; }
    .pt-busqueda { display: grid; gap: 4px; width: min(100%, 340px); font-size: .82rem; font-weight: 750; }
    .pt-busqueda-campo { position: relative; display: block; }
    .pt-busqueda-campo svg { position: absolute; top: 12px; left: 12px; width: 18px; color: #78669e; pointer-events: none; }
    .pt-busqueda input {
        width: 100%;
        min-height: 42px;
        padding: 8px 10px 8px 38px;
        border: 1px solid #d9cee9;
        border-radius: 10px;
        background: #fcfaff;
        color: var(--pt-ink);
        font: inherit;
        font-weight: 500;
    }

    .pt-filtros { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 15px; }
    .pt-filtros button, .pt-acciones button, .pt-cerrar {
        cursor: pointer;
        font: inherit;
    }
    .pt-filtros button {
        min-height: 36px;
        padding: 5px 12px;
        border: 1px solid var(--pt-border);
        border-radius: 999px;
        color: var(--pt-muted);
        background: #fff;
        font-size: .83rem;
        font-weight: 750;
    }
    .pt-filtros button:hover { background: #f7f2ff; }
    .pt-filtros button[aria-pressed="true"] { border-color: #ded0fc; background: #ede4ff; color: #4d26a7; }

    .pt-area {
        --pt-acento: #5b2fc1;
        --pt-suave: #eee5ff;
        margin: 28px 0 0;
    }
    .pt-area[data-area="juego"] { --pt-acento: #175bb4; --pt-suave: #e3efff; }
    .pt-area[data-area="editor"] { --pt-acento: #14745d; --pt-suave: #dff5ec; }
    .pt-area[data-area="admin"] { --pt-acento: #8b5105; --pt-suave: #fff0d9; }
    .pt-area-cabecera { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .pt-area-icono {
        display: grid;
        place-items: center;
        width: 35px;
        height: 35px;
        border-radius: 10px;
        background: var(--pt-suave);
        color: var(--pt-acento);
        font-size: .77rem;
        font-weight: 850;
    }
    .pt-area-cabecera h2 { font-size: 1.27rem; font-weight: 850; letter-spacing: -.02em; }
    .pt-area-cantidad {
        padding: 2px 8px;
        border: 1px solid var(--pt-border);
        border-radius: 999px;
        color: var(--pt-muted);
        background: #fff;
        font-size: .76rem;
        font-weight: 750;
    }

    .pt-grilla { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .pt-tarjeta {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-height: 138px;
        padding: 15px 16px 13px;
        border: 1px solid var(--pt-border);
        border-top: 3px solid var(--pt-suave);
        border-radius: 15px;
        background: #fff;
        box-shadow: 0 3px 10px #35265b08;
    }
    .pt-tarjeta:hover, .pt-tarjeta:focus-within { border-top-color: var(--pt-acento); }
    .pt-hu {
        padding: 2px 7px;
        border-radius: 6px;
        background: var(--pt-suave);
        color: var(--pt-acento);
        font-size: .7rem;
        font-weight: 850;
        letter-spacing: .03em;
    }
    .pt-tarjeta h3 {
        margin: 7px 0 10px;
        font-size: 1rem;
        line-height: 1.35;
        font-weight: 800;
        overflow-wrap: anywhere;
    }
    .pt-acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin-top: auto; }
    .pt-acciones a, .pt-dialogo-link {
        color: #5226b8;
        text-decoration: underline;
        text-underline-offset: 3px;
        font-size: .82rem;
        font-weight: 750;
    }
    .pt-acciones button {
        padding: 5px 8px;
        border: 1px solid var(--pt-border);
        border-radius: 8px;
        color: #4c3974;
        background: #fbf8ff;
        font-size: .82rem;
        font-weight: 750;
    }
    .pt-acciones button:hover { background: #eee5ff; }

    .pt-vacio {
        padding: 22px;
        border: 1px dashed #d9cdec;
        border-radius: 14px;
        color: var(--pt-muted);
        text-align: center;
    }

    .pt-dialogo {
        width: min(540px, calc(100% - 28px));
        max-height: 85vh;
        padding: 0;
        border: 1px solid var(--pt-border);
        border-radius: 18px;
        color: var(--pt-ink);
        background: #fff;
        box-shadow: 0 20px 80px #1c10394d;
    }
    .pt-dialogo::backdrop { background: #1c103977; }
    .pt-dialogo-contenido { padding: 22px; }
    .pt-dialogo-cabecera { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
    .pt-dialogo-kicker { color: var(--pt-purple); font-size: .76rem; font-weight: 850; text-transform: uppercase; letter-spacing: .06em; }
    .pt-dialogo h2 { font-size: 1.25rem; line-height: 1.3; font-weight: 850; }
    .pt-cerrar {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        color: #4d367c;
        background: #f2ebff;
        font-size: 1.5rem;
    }
    .pt-dialogo-mensaje { margin-top: 14px !important; color: var(--pt-muted); font-size: .88rem; }
    .pt-incrustacion { overflow-x: auto; margin-top: 10px; }
    .pt-incrustacion iframe { max-width: 100%; }
    .pt-dialogo-link { display: inline-block; margin-top: 12px; }

    @media (max-width: 850px) {
        .pt-grilla { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 590px) {
        .pt-hero, .pt-controles-cabecera { flex-direction: column; align-items: flex-start; }
        .pt-hero { gap: 18px; }
        .pt-grilla { grid-template-columns: minmax(0, 1fr); }
        .pt-tarjeta { min-height: 0; }
    }
</style>

