                <div class="pt-acciones">
                    <button type="button" data-preview aria-label="Vista previa: Imprimir reportes" hidden>Vista previa</button>
                    <a href="https://trello.com/c/bldV2HKS" data-card-link target="_blank" rel="noopener noreferrer">
                        Abrir en Trello <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </article>
        </div>
    </section>

    <dialog class="pt-dialogo" aria-labelledby="pt-dialogo-titulo">
        <div class="pt-dialogo-contenido">
            <header class="pt-dialogo-cabecera">
                <div>
                    <p class="pt-dialogo-kicker">Tarjeta de Trello</p>
                    <h2 id="pt-dialogo-titulo"></h2>
                </div>
                <form method="dialog">
                    <button class="pt-cerrar" type="submit" aria-label="Cerrar vista previa" autofocus>×</button>
                </form>
            </header>
            <p class="pt-dialogo-mensaje" data-preview-message role="status">Cargando vista previa…</p>
            <div class="pt-incrustacion" data-embed></div>
            <a class="pt-dialogo-link" data-preview-link target="_blank" rel="noopener noreferrer">
                Abrir tarjeta en Trello <span aria-hidden="true">↗</span>
            </a>
        </div>
    </dialog>
</main>

<script>
    (() => {
        const panel = document.getElementById('trello-panel');
        const grupos = [...panel.querySelectorAll('[data-area]')];
        const filtros = [...panel.querySelectorAll('[data-filter]')];
        const buscador = panel.querySelector('[data-search]');
        const conteo = panel.querySelector('[data-count]');
        const vacio = panel.querySelector('[data-empty]');
        const dialogo = panel.querySelector('dialog');
        const titulo = panel.querySelector('#pt-dialogo-titulo');
        const destino = panel.querySelector('[data-preview-link]');
        const espacio = panel.querySelector('[data-embed]');
        const mensaje = panel.querySelector('[data-preview-message]');
        let area = 'todas';
        let cargaTrello;
        let solicitud = 0;

        const normalizar = (texto) => texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

        function actualizar() {
            const palabras = normalizar(buscador.value.trim()).split(/\s+/);
            let visibles = 0;

            for (const grupo of grupos) {
                let cantidad = 0;
                const categoria = grupo.querySelector('h2').textContent;

                for (const tarjeta of grupo.querySelectorAll('[data-card]')) {
                    const texto = normalizar(tarjeta.querySelector('h3').textContent
                            + ' ' + tarjeta.querySelector('.pt-hu').textContent + ' ' + categoria);
                    const visible = (area === 'todas' || grupo.dataset.area === area)
                            && palabras.every((palabra) => texto.includes(palabra));
                    tarjeta.hidden = !visible;
                    if (visible) cantidad++;
                }

                grupo.hidden = cantidad === 0;
                grupo.querySelector('[data-area-count]').textContent = cantidad;
                visibles += cantidad;
            }

            conteo.textContent = visibles === 1 ? '1 tarea' : visibles + ' tareas';
            vacio.hidden = visibles !== 0;
        }

        buscador.closest('label').hidden = false;
        panel.querySelector('.pt-filtros').hidden = false;
        buscador.addEventListener('input', actualizar);

        for (const filtro of filtros) {
            filtro.addEventListener('click', () => {
                area = filtro.dataset.filter;
                for (const otro of filtros) {
                    otro.setAttribute('aria-pressed', String(otro === filtro));
                }
                actualizar();
            });
        }

        if (typeof dialogo.showModal !== 'function') return;
        panel.querySelectorAll('[data-preview]').forEach((boton) => { boton.hidden = false; });

        // El script oficial se descarga recién al abrir la primera tarjeta.
        function cargarTrello() {
            if (window.TrelloCards?.create) return Promise.resolve(window.TrelloCards);

            if (!cargaTrello) {
                cargaTrello = new Promise((resolve, reject) => {
                    const script = document.createElement('script');
                    script.src = 'https://p.trellocdn.com/embed.min.js';
                    script.onload = () => {
                        if (window.TrelloCards?.create) resolve(window.TrelloCards);
                        else reject(new Error('Trello no está disponible'));
                    };
                    script.onerror = reject;
                    document.head.appendChild(script);
                }).catch((error) => {
                    cargaTrello = null;
                    throw error;
                });
            }

            return cargaTrello;
        }

        panel.addEventListener('click', async (evento) => {
            const boton = evento.target.closest('[data-preview]');
            if (!boton) return;

            const tarjeta = boton.closest('[data-card]');
            const enlace = tarjeta.querySelector('[data-card-link]');
            const actual = ++solicitud;
            titulo.textContent = tarjeta.querySelector('h3').textContent;
            destino.href = enlace.href;
            espacio.replaceChildren();
            mensaje.textContent = 'Cargando vista previa…';
            dialogo.showModal();

            try {
                const trello = await cargarTrello();
                if (!dialogo.open || actual !== solicitud) return;

                const contenedor = document.createElement('div');
                espacio.appendChild(contenedor);
                trello.create(enlace.href, contenedor, { compact: false });
                mensaje.textContent = 'Si la vista previa no carga, abrí la tarjeta directamente en Trello.';
            } catch {
                if (dialogo.open && actual === solicitud) {
                    mensaje.textContent = 'La vista previa no está disponible. Podés abrir la tarjeta en Trello.';
                }
            }
        });

        dialogo.addEventListener('close', () => {
            solicitud++;
            espacio.replaceChildren();
        });
    })();
</script>
