<link rel="stylesheet" href="/css/preguntaSugerida.css?v=2">
<link rel="stylesheet" href="/css/editor.css?v=8">

<main class="pregunta-sugerida-pagina">

    <div style="max-width: 850px; margin: 0 auto 16px;">
        <a href="/editor/mostrarGestionPreguntas"
           class="editor-volver">
            ← Volver a gestión de preguntas
        </a>
    </div>

    <section class="pregunta-sugerida-contenedor">

        <div class="pregunta-sugerida-encabezado">
            <h1>Nueva pregunta</h1>

            <p>
                Completá todos los campos para incorporar una nueva pregunta al juego.
            </p>
        </div>

        {{#hay_errores}}
            <div class="pregunta-sugerida-errores">
                <p>No se pudo crear la pregunta:</p>

                <ul>
                    {{#errores}}
                        <li>{{.}}</li>
                    {{/errores}}
                </ul>
            </div>
        {{/hay_errores}}

        {{#exito}}
            <div class="pregunta-sugerida-exito">
                <p>{{mensaje_exito}}</p>
            </div>
        {{/exito}}

        <form method="post"
              action="/editor/crearNuevaPregunta"
              class="pregunta-sugerida-formulario">

            <input type="hidden"
                   name="csrf_token"
                   value="{{tokenCSRF}}">

            <div class="campo">
                <label for="pregunta">Pregunta</label>

                <textarea id="pregunta"
                          name="pregunta"
                          placeholder="Escribí la pregunta..."
                          required>{{pregunta}}</textarea>
            </div>

            <div class="campo">
                <label for="categoria">Categoría</label>

                <select id="categoria"
                        name="categoria_id"
                        required>

                    <option value="">
                        Seleccioná una categoría
                    </option>

                    {{#categorias}}
                        <option value="{{id}}"
                                {{#seleccionada}}selected{{/seleccionada}}>
                            {{nombre}}
                        </option>
                    {{/categorias}}

                </select>
            </div>

            <fieldset class="opciones">

                <legend>Opciones de respuesta</legend>

                <p>
                    Escribí las cuatro respuestas e indicá cuál es la correcta.
                </p>

                <div class="opcion">

                    <input type="radio"
                           name="respuesta_correcta"
                           value="A"
                           id="correcta-a"
                           {{#correcta_a}}checked{{/correcta_a}}
                           required>

                    <label for="opcion-a">A</label>

                    <input type="text"
                           id="opcion-a"
                           name="opcion_a"
                           placeholder="Respuesta A"
                           value="{{opcion_a}}"
                           required>
                </div>

                <div class="opcion">

                    <input type="radio"
                           name="respuesta_correcta"
                           value="B"
                           id="correcta-b"
                           {{#correcta_b}}checked{{/correcta_b}}>

                    <label for="opcion-b">B</label>

                    <input type="text"
                           id="opcion-b"
                           name="opcion_b"
                           placeholder="Respuesta B"
                           value="{{opcion_b}}"
                           required>
                </div>

                <div class="opcion">

                    <input type="radio"
                           name="respuesta_correcta"
                           value="C"
                           id="correcta-c"
                           {{#correcta_c}}checked{{/correcta_c}}>

                    <label for="opcion-c">C</label>

                    <input type="text"
                           id="opcion-c"
                           name="opcion_c"
                           placeholder="Respuesta C"
                           value="{{opcion_c}}"
                           required>
                </div>

                <div class="opcion">

                    <input type="radio"
                           name="respuesta_correcta"
                           value="D"
                           id="correcta-d"
                           {{#correcta_d}}checked{{/correcta_d}}>

                    <label for="opcion-d">D</label>

                    <input type="text"
                           id="opcion-d"
                           name="opcion_d"
                           placeholder="Respuesta D"
                           value="{{opcion_d}}"
                           required>
                </div>

            </fieldset>

            <button type="submit"
                    class="boton-enviar">
                Crear pregunta
            </button>

        </form>

    </section>

</main>