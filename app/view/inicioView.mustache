<link rel="stylesheet" href="/css/inicio.css">
<main>
    {{#hayErroresPartida}}
        <div class="w3-panel w3-pale-red w3-leftbar w3-border-red"
             role="alert">
            <ul>
                {{#erroresPartida}}
                    <li>{{.}}</li>
                {{/erroresPartida}}
            </ul>
        </div>
    {{/hayErroresPartida}}
    <!-- ===== FILA SUPERIOR: SALUDO + PROGRESO ===== -->
    <div class="fila-superior">

        <section class="saludo">
            <h1>¡Hola, {{nombre}}!</h1>
            <h2>¿Jugamos una partida?</h2>
        </section>

        <section class="progreso">
            <h2 class="solo-lectores">Tu progreso</h2>

            <article>
                <span class="dato-icono dato-icono-puntaje" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
                        <polygon points="12,2.5 14.47,9.1 21.51,9.41 15.99,13.8 17.88,20.59 12,16.7 6.12,20.59 8.01,13.8 2.49,9.41 9.53,9.1"/>
                    </svg>
                </span>
                <div>
                    <h3>Tu puntaje</h3>
                    <p>{{puntaje}} <span class="unidad">puntos</span></p>
                </div>
            </article>

            <article>
                <span class="dato-icono dato-icono-posicion" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <rect x="3.5" y="13" width="4.5" height="8" rx="1.3"/>
                        <rect x="9.75" y="8" width="4.5" height="13" rx="1.3"/>
                        <rect x="16" y="3" width="4.5" height="18" rx="1.3"/>
                    </svg>
                </span>
                <div>
                    <h3>Tu posición</h3>
                    <p>#{{posicion}}</p>
                </div>
            </article>

            <article>
                <span class="dato-icono dato-icono-partidas" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M7 6.5h10a5 5 0 0 1 4.9 4l.9 4.4a3 3 0 0 1-5.2 2.5L15.4 15.5H8.6l-2.2 1.9a3 3 0 0 1-5.2-2.5l.9-4.4A5 5 0 0 1 7 6.5z"/>
                        <path class="detalle" d="M7.2 9.3h1.4v1.4H10v1.4H8.6v1.4H7.2v-1.4H5.8v-1.4h1.4V9.3z"/>
                        <circle class="detalle" cx="15.6" cy="10" r="1.1"/>
                        <circle class="detalle" cx="18.2" cy="12.2" r="1.1"/>
                    </svg>
                </span>
                <div>
                    <h3>Partidas jugadas</h3>
                    <p>{{partidasJugadas}}</p>
                </div>
            </article>
        </section>

    </div>

    <!-- ===== FILA PRINCIPAL: BANNER JUGAR + RANKING ===== -->
    <div class="fila-principal">

        <section class="banner-jugar">
            <div class="banner-texto">
                <h2>¿Cuánto sabés?</h2>
                <p>Respondé, sumá puntos y subí en el ranking.</p>

                <form method="post" action="/partida/crear">
                    <button type="submit" class="boton-jugar">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 4.5v15a1 1 0 0 0 1.5.9l12-7.5a1 1 0 0 0 0-1.8l-12-7.5A1 1 0 0 0 7 4.5z"/>
                        </svg>
                        Jugar
                    </button>
                </form>
            </div>

            <!-- Ilustración: trofeo, mundo, foco y signos de pregunta -->
            <svg class="banner-ilustracion" viewBox="0 0 480 340" aria-hidden="true" focusable="false">
                <defs>
                    <linearGradient id="trofeo-oro" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#ffe066"/>
                        <stop offset="1" stop-color="#f4a100"/>
                    </linearGradient>
                    <linearGradient id="trofeo-mundo" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#4fb3ff"/>
                        <stop offset="1" stop-color="#1f6fd1"/>
                    </linearGradient>
                    <linearGradient id="trofeo-foco" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#ffe680"/>
                        <stop offset="1" stop-color="#ffb800"/>
                    </linearGradient>
                    <clipPath id="trofeo-clip-mundo">
                        <circle cx="132" cy="255" r="60"/>
                    </clipPath>
                    <g id="signo-pregunta">
                        <path d="M-18 -20C-18 -44 18 -44 18 -18C18 -2 0 0 0 18" fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="0" cy="40" r="8" fill="currentColor"/>
                    </g>
                </defs>

                <!-- destellos -->
                <g stroke="#f7c531" stroke-width="6" stroke-linecap="round">
                    <path d="M188 40l9 22"/>
                    <path d="M312 42l-9 22"/>
                    <path d="M58 120l20 10"/>
                    <path d="M440 210l22-10"/>
                </g>
                <g stroke="#5b2fd9" stroke-width="4" stroke-linecap="round">
                    <path d="M340 262l-6 14"/>
                    <path d="M348 278l-3 8"/>
                </g>

                <!-- sombra y pedestal -->
                <ellipse cx="250" cy="316" rx="200" ry="16" fill="#b9a2f2" opacity=".55"/>
                <rect x="190" y="268" width="120" height="42" rx="8" fill="#4a2bb0"/>
                <rect x="190" y="268" width="120" height="14" rx="7" fill="#6a49d8"/>

                <!-- trofeo -->
                <path d="M170 112H142C138 156 158 182 186 188" fill="none" stroke="url(#trofeo-oro)" stroke-width="15" stroke-linecap="round"/>
                <path d="M330 112H358C362 156 342 182 314 188" fill="none" stroke="url(#trofeo-oro)" stroke-width="15" stroke-linecap="round"/>
                <rect x="236" y="212" width="28" height="34" fill="#f0a000"/>
                <rect x="208" y="244" width="84" height="26" rx="7" fill="url(#trofeo-oro)"/>
                <path d="M170 92H330C330 172 304 214 250 220C196 214 170 172 170 92Z" fill="url(#trofeo-oro)"/>
                <rect x="166" y="86" width="168" height="14" rx="7" fill="#ffd84a"/>
                <polygon points="250,118 257.6,137.5 278.5,138.7 262.4,152 267.6,172.3 250,161 232.4,172.3 237.6,152 221.5,138.7 242.4,137.5" fill="#fff1a8" stroke="#fff1a8" stroke-width="4" stroke-linejoin="round"/>

                <!-- mundo -->
                <circle cx="132" cy="255" r="60" fill="url(#trofeo-mundo)"/>
                <g clip-path="url(#trofeo-clip-mundo)" fill="#43b86b">
                    <path d="M92 228c12-16 32-18 42-8s-2 20-14 22-34 8-28-14z"/>
                    <path d="M138 262c12-8 30-4 36 10s-4 26-18 26-26-22-18-36z"/>
                    <path d="M96 280c8 0 14 8 10 16s-16 4-18-6 2-10 8-10z"/>
                </g>
                <ellipse cx="108" cy="222" rx="14" ry="8" fill="#fff" opacity=".28" transform="rotate(-30 108 222)"/>

                <!-- foco -->
                <circle cx="392" cy="240" r="38" fill="url(#trofeo-foco)"/>
                <path d="M373 270h38l-5 18h-28z" fill="#ffc21a"/>
                <rect x="374" y="288" width="36" height="16" rx="6" fill="#4a2bb0"/>
                <path d="M381 246l11-13 11 13M392 246v18" fill="none" stroke="#e58a00" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
                <ellipse cx="378" cy="226" rx="8" ry="12" fill="#fff" opacity=".35" transform="rotate(25 378 226)"/>

                <!-- signos de pregunta -->
                <use href="#signo-pregunta" color="#5b1fe0" transform="translate(250 50) scale(1.05)"/>
                <use href="#signo-pregunta" color="#1fc8bd" transform="translate(88 150) rotate(-16) scale(.8)"/>
                <use href="#signo-pregunta" color="#ef4b4b" transform="translate(398 140) rotate(16) scale(.8)"/>
            </svg>
        </section>

        <!-- RESUMEN DEL RANKING (hardcodeado) -->
        <section class="ranking-resumen">
            <h2>Ranking semanal</h2>

            <ol class="ranking-lista">
                <li class="ranking-item">
                    <span class="medalla medalla-oro">1</span>
                    <span class="ranking-jugador">Mateo</span>
                    <span class="ranking-puntos">620 pts</span>
                </li>
                <li class="ranking-item">
                    <span class="medalla medalla-plata">2</span>
                    <span class="ranking-jugador">Sofía</span>
                    <span class="ranking-puntos">580 pts</span>
                </li>
                <li class="ranking-item">
                    <span class="medalla medalla-bronce">3</span>
                    <span class="ranking-jugador">Lucas</span>
                    <span class="ranking-puntos">540 pts</span>
                </li>
            </ol>

            <button type="button" class="boton-ranking">
                Ver ranking completo
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
            </button>
        </section>

    </div>

    <!-- ===== CATEGORÍAS (píldoras informativas, no son botones) ===== -->
    <section class="categorias">
        <h2>Todas las categorías</h2>

        <ul class="categorias-lista">

            <li class="categoria categoria-historia">
                <span class="categoria-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 3 2 8v2h20V8L12 3zM4 11v7h2.5v-7H4zm4.75 0v7h2.5v-7h-2.5zm4 0v7h2.5v-7h-2.5zm4.75 0v7H20v-7h-2.5zM3 19.5V22h18v-2.5H3z"/>
                    </svg>
                </span>
                <span class="categoria-nombre">Historia</span>
            </li>

            <li class="categoria categoria-deportes">
                <span class="categoria-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M12 8.2l3.4 2.5-1.3 4H9.9l-1.3-4L12 8.2z"/>
                        <path d="M12 8.2V3.3M15.4 10.7l4.6-1.5M14.1 14.7l2.9 3.9M9.9 14.7L7 18.6M8.6 10.7L4 9.2"/>
                    </svg>
                </span>
                <span class="categoria-nombre">Deportes</span>
            </li>

            <li class="categoria categoria-ciencia">
                <span class="categoria-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 3h6v2h-1v4.6l5.2 8.7A2 2 0 0 1 17.5 21h-11a2 2 0 0 1-1.7-2.7L10 9.6V5H9V3z"/>
                        <path class="hueco" d="M8.3 14h7.4l1.6 2.7H6.7L8.3 14z"/>
                    </svg>
                </span>
                <span class="categoria-nombre">Ciencia</span>
            </li>

            <li class="categoria categoria-entretenimiento">
                <span class="categoria-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M6.5 10h11l-1.4 11H7.9L6.5 10z"/>
                        <path class="hueco" d="M10 11v9.5h1.2V11H10zm2.8 0v9.5H14V11h-1.2z"/>
                        <circle cx="8" cy="7.2" r="2.3"/>
                        <circle cx="12" cy="6" r="2.7"/>
                        <circle cx="16" cy="7.2" r="2.3"/>
                    </svg>
                </span>
                <span class="categoria-nombre">Arte</span>
            </li>

        </ul>
    </section>

    <!-- ===== FILA INFERIOR: ÚLTIMAS PARTIDAS + SUGERIR PREGUNTA ===== -->
    <div class="fila-inferior">

        <section class="ultimas-partidas">
            <div class="tarjeta-cabecera">
                <h2>Mis últimas partidas</h2>
                <button type="button" class="enlace-boton">
                    Ver todas
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>

            {{#tienePartidas}}
                <table class="tabla-partidas">
                    <thead>
                    <tr>
                        <th>Partida</th>
                        <th>Fecha</th>
                        <th>Puntaje</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#ultimasPartidas}}
                        <tr>
                            <td>#{{numero}}</td>
                            <td>{{fecha}}</td>
                            <td>{{puntaje}} puntos</td>
                        </tr>
                    {{/ultimasPartidas}}
                    </tbody>
                </table>
            {{/tienePartidas}}

            {{^tienePartidas}}
                <p class="mensaje-vacio">
                    Todavía no jugaste ninguna partida. ¡Animate a jugar tu primera!
                </p>
            {{/tienePartidas}}
        </section>

        <section class="sugerir">
            <svg class="sugerir-ilustracion" viewBox="0 0 200 210" aria-hidden="true" focusable="false">
                <g stroke="#f7c531" stroke-width="5" stroke-linecap="round">
                    <path d="M150 30l-8 18"/>
                    <path d="M178 52l-18 6"/>
                    <path d="M14 66l16 10"/>
                    <path d="M10 112l18 4"/>
                </g>
                <path d="M95 18c-40 0-70 27-70 60 0 20 10 36 26 47l-9 29 34-19c6 1 12 2 19 2 40 0 70-27 70-60S135 18 95 18z" fill="#fff" stroke="#ece4fb" stroke-width="2"/>
                <use href="#signo-pregunta" color="#6a2ee8" transform="translate(95 74) scale(.95)"/>
                <path d="M128 128c-24 0-42 14-42 32s18 32 42 32c5 0 10-1 14-2l24 12-7-22c7-6 11-13 11-20 0-18-18-32-42-32z" fill="#4aa8ff"/>
                <g fill="#fff">
                    <circle cx="112" cy="160" r="5"/>
                    <circle cx="129" cy="160" r="5"/>
                    <circle cx="146" cy="160" r="5"/>
                </g>
            </svg>

            <div class="sugerir-contenido">
                <h2>¿Tenés una buena pregunta?</h2>
                <p>Ayudá a que el juego siga creciendo.</p>
                <button type="button" class="boton-sugerir">Sugerir pregunta</button>
            </div>
        </section>

    </div>

</main>
