<script>
    if (typeof ResizeObserver === 'function') {
        const piePagina = document.querySelector('.pie-pagina');
        new ResizeObserver(() => {
            const altura = Math.ceil(piePagina.getBoundingClientRect().height);
            document.documentElement.style.setProperty('--altura-pie-pagina', altura + 'px');
        }).observe(piePagina, {box: 'border-box'});
    }
</script>

