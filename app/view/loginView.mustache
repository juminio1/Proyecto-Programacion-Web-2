<main class="login-contenedor">
    <section class="login-tarjeta w3-card"
             aria-labelledby="login-titulo">

        <h1 id="login-titulo" class="login-titulo">
            Iniciar sesión
        </h1>

        <p class="login-subtitulo">
            Ingresá con tu usuario o correo electrónico.
        </p>

        {{#hay_errores}}
            <div class="login-errores w3-panel" role="alert">
                <ul>
                    {{#errores}}
                        <li>{{.}}</li>
                    {{/errores}}
                </ul>
            </div>
        {{/hay_errores}}

        <form method="post" action="/login/login">


            <div class="login-campo">
                <label for="usuario">
                    Usuario o correo electrónico
                </label>

                <input class="w3-input"
                       type="text"
                       id="usuario"
                       name="usuario"
                       value="{{usuario}}"
                       autocomplete="username"
                       autocapitalize="none"
                       spellcheck="false"
                       required>
            </div>

            <div class="login-campo">
                <label for="password">
                    Contraseña
                </label>

                <input class="w3-input"
                       type="password"
                       id="password"
                       name="password"
                       autocomplete="current-password"
                       required>
            </div>

            <button type="submit" class="login-boton">
                Ingresar
            </button>
        </form>

        <p class="login-pie">
            ¿Todavía no tenés cuenta?
            <a href="/registro/show">
                Registrate
            </a>
        </p>
    </section>
</main>

