<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
    >

    <title>Preguntados</title>


    <!-- =====================================================
         TEMA INICIAL
         Evita un cambio visual al cargar la página
         ===================================================== -->

    <script>
        (function () {

            try {

                var tema = localStorage.getItem('tema');

                if (!tema) {

                    tema = (
                            window.matchMedia &&
                            window.matchMedia('(prefers-color-scheme: dark)').matches
                    )
                            ? 'oscuro'
                            : 'claro';
                }

                if (tema === 'oscuro') {

                    document.documentElement.setAttribute(
                            'data-theme',
                            'dark'
                    );

                    document.documentElement.classList.add(
                            'dark-mode'
                    );

                } else {

                    document.documentElement.setAttribute(
                            'data-theme',
                            'light'
                    );

                    document.documentElement.classList.remove(
                            'dark-mode'
                    );
                }

            } catch (e) {
                // Si localStorage no está disponible,
                // la página continúa normalmente.
            }

        })();
    </script>


    <!-- W3.CSS -->

    <link
            rel="stylesheet"
            href="https://www.w3schools.com/w3css/4/w3.css"
    >


    <!-- CSS DEL PROYECTO -->

    <link
            rel="stylesheet"
            href="/css/header.css?v=3"
    >

    <link
            rel="stylesheet"
            href="/css/login.css"
    >

    <link
            rel="stylesheet"
            href="/css/dark-mode.css?v=2"
    >


    <!-- MODO OSCURO -->

    <script
            src="/js/dark-mode.js"
            defer
    ></script>

</head>


<body{{#paginaLogin}} class="pagina-login"{{/paginaLogin}}>


<header class="barra-superior">

    <div class="barra-contenido">


        <!-- =================================================
             LOGO
             ================================================= -->

        <a
                class="logo"
                href="{{enlaceLogo}}"
                aria-label="Ir al inicio de Preguntados"
        >

            <img
                    class="logo-imagen"
                    src="/public/img/logo-preguntados.webp"
                    alt="Preguntados"
                    width="768"
                    height="106"
            >

        </a>


        <!-- =================================================
             NAVEGACIÓN
             ================================================= -->

        <nav class="barra-nav" aria-label="Navegación principal">
            {{#esEditor}}
                <a href="/editor/show"{{#editorActivo}} class="activo" aria-current="page"{{/editorActivo}}>Panel editor</a>
            {{/esEditor}}
            {{^esEditor}}
                <a href="/inicio/show"{{#inicioActivo}} class="activo" aria-current="page"{{/inicioActivo}}>Inicio</a>
                <a href="/ranking/show"{{#rankingActivo}} class="activo" aria-current="page"{{/rankingActivo}}>Ranking</a>
            {{/esEditor}}
        </nav>


        <!-- =================================================
             ACCIONES
             ================================================= -->

        <div class="acciones-usuario">


            <!-- MODO CLARO / OSCURO -->

            <button
                    type="button"
                    id="boton-modo-oscuro"
                    class="boton-tema"
                    role="switch"
                    aria-checked="false"
                    aria-label="Cambiar a modo oscuro"
                    title="Cambiar a modo oscuro"
            >

                <span
                        class="boton-tema-icono"
                        aria-hidden="true"
                >


                    <!-- SOL -->

                    <svg
                            class="icono-sol"
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                    >

                        <circle
                                cx="12"
                                cy="12"
                                r="5"
                        ></circle>

                        <line
                                x1="12"
                                y1="1"
                                x2="12"
                                y2="3"
                        ></line>

                        <line
                                x1="12"
                                y1="21"
                                x2="12"
                                y2="23"
                        ></line>

                        <line
                                x1="4.22"
                                y1="4.22"
                                x2="5.64"
                                y2="5.64"
                        ></line>

                        <line
                                x1="18.36"
                                y1="18.36"
                                x2="19.78"
                                y2="19.78"
                        ></line>

                        <line
                                x1="1"
                                y1="12"
                                x2="3"
                                y2="12"
                        ></line>

                        <line
                                x1="21"
                                y1="12"
                                x2="23"
                                y2="12"
                        ></line>

                        <line
                                x1="4.22"
                                y1="19.78"
                                x2="5.64"
                                y2="18.36"
                        ></line>

                        <line
                                x1="18.36"
                                y1="5.64"
                                x2="19.78"
                                y2="4.22"
                        ></line>

                    </svg>


                    <!-- LUNA -->

                    <svg
                            class="icono-luna"
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="currentColor"
                            stroke="none"
                    >

                        <path
                                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                        ></path>

                    </svg>

                </span>


                <span class="boton-tema-texto">
                    Modo oscuro
                </span>

            </button>


            <!-- =================================================
                 USUARIO LOGUEADO
                 ================================================= -->

            {{#sesionIniciada}}

                <details class="usuario">

                    <summary{{#perfilActivo}} class="perfil-activo"{{/perfilActivo}}>

                        <span
                                class="avatar"
                                aria-hidden="true"
                        >
                            {{inicial}}
                        </span>


                        <span class="usuario-nombre">
                            {{nombre}}
                        </span>


                        <svg
                                class="usuario-flecha"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                        >
                            <path d="M6 9l6 6 6-6"/>
                        </svg>

                    </summary>


                    <!-- MENÚ -->

                    <div class="usuario-menu">

                        {{^esEditor}}
                            <a href="/perfil/show" class="usuario-menu-item">Mi perfil</a>
                            <div class="usuario-menu-separador" aria-hidden="true"></div>
                        {{/esEditor}}

                        <form
                                method="post"
                                action="/login/logout"
                        >

                            <button
                                    type="submit"
                                    class="usuario-boton-salir"
                            >
                                Cerrar sesión
                            </button>

                        </form>

                    </div>

                </details>

            {{/sesionIniciada}}


            <!-- =================================================
                 USUARIO NO LOGUEADO
                 ================================================= -->

            {{^sesionIniciada}}

                <a
                        class="boton-login"
                        href="/login/show"
                >
                    Iniciar sesión
                </a>

            {{/sesionIniciada}}

        </div>

    </div>

</header>
