<link rel="stylesheet" href="/css/editor.css?v=paginacion-categorias-1">

<main class="editor" aria-labelledby="categorias-titulo">
    <a class="editor-volver" href="/editor/show">← Volver al panel del editor</a>

    <section class="editor-panel">
        <div class="editor-preguntas-cabecera">
            <div class="editor-preguntas-cabecera-texto">
                <p class="editor-etiqueta">GESTIÓN DEL EDITOR</p>
                <h1 id="categorias-titulo">Categorías</h1>
            </div>
            <div class="editor-preguntas-acciones">
                <a href="/editor/nuevaCategoria" class="editor-boton editor-boton-nueva-pregunta">
                    <span aria-hidden="true">+</span> Nueva categoría
                </a>
            </div>
        </div>
        {{#mensajeExito}}
            <p class="editor-aviso editor-aviso-exito" role="status">{{mensajeExito}}</p>
        {{/mensajeExito}}
        {{#mensajeError}}
            <p class="editor-aviso editor-aviso-error" role="alert">{{mensajeError}}</p>
        {{/mensajeError}}
        {{#mostrarBuscador}}
            <form class="editor-preguntas-herramientas editor-categorias-busqueda"
                  method="get" action="/editor/mostrarGestionCategorias" role="search" aria-label="Categorías">
                <div class="editor-preguntas-buscador">
                    <label for="buscar-categoria">Buscar categoría</label>
                    <input id="buscar-categoria" name="buscar" type="search" value="{{buscar}}"
                           placeholder="Nombre de la categoría" autocomplete="off">
                </div>
                <div class="editor-categorias-busqueda-acciones">
                    <button class="editor-boton" type="submit">Buscar</button>
                    {{#hayBusqueda}}
                        <a class="editor-boton editor-boton-rechazar" href="/editor/mostrarGestionCategorias">Limpiar</a>
                    {{/hayBusqueda}}
                </div>
            </form>
        {{/mostrarBuscador}}
        {{#hayCategorias}}
            <div id="tabla-categorias" class="editor-categorias-tabla-contenedor"
                 role="region" aria-label="Categorías registradas" tabindex="0">
                <table class="editor-categorias-tabla">
                    <caption class="editor-texto-accesible">Categorías registradas</caption>
                    <thead>
                    <tr>
                        <th scope="col">Categoría</th>
                        <th scope="col">Color</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Preguntas habilitadas</th>
                        <th scope="col">Acciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    {{#categorias}}
                        <tr>
                            <th scope="row">{{nombre}}</th>
                            <td>
                                    <span class="editor-categoria-muestra" style="--categoria-color: {{color}};">
                                        <span class="editor-categoria-punto" aria-hidden="true"></span>{{color}}
                                    </span>
                            </td>
                            <td>{{#habilitada}}Habilitada{{/habilitada}}{{^habilitada}}Deshabilitada{{/habilitada}}</td>
                            <td class="editor-categoria-cantidad">{{cantidad_preguntas}}</td>
                            <td>
                                {{#habilitada}}
                                    <a href="{{urlEditar}}"
                                       class="editor-accion editor-accion-editar"
                                       title="Editar categoría" aria-label="Editar categoría {{nombre}}">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 20h9"></path>
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                                        </svg>
                                    </a>
                                    <button type="button" class="editor-accion editor-accion-baja"
                                            data-baja-categoria="{{id}}" data-nombre="{{nombre}}"
                                            aria-haspopup="dialog" aria-label="Dar de baja {{nombre}}" title="Dar de baja">
                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v5M14 11v5"></path>
                                        </svg>
                                    </button>
                                {{/habilitada}}
                            </td>
                        </tr>
                    {{/categorias}}
                    </tbody>
                </table>
            </div>
            {{#mostrarPaginacion}}
                <nav class="editor-categorias-paginacion" aria-label="Páginas de categorías">
                    {{#urlAnterior}}
                        <a class="editor-boton editor-boton-rechazar" href="{{urlAnterior}}" rel="prev">Anterior</a>
                    {{/urlAnterior}}
                    <span>Página {{pagina}} de {{totalPaginas}}</span>
                    {{#urlSiguiente}}
                        <a class="editor-boton editor-boton-rechazar" href="{{urlSiguiente}}" rel="next">Siguiente</a>
                    {{/urlSiguiente}}
                </nav>
            {{/mostrarPaginacion}}
        {{/hayCategorias}}
        {{#sinCategorias}}
            {{#hayBusqueda}}
                <p role="status">No se encontraron categorías con ese nombre.</p>
            {{/hayBusqueda}}
            {{^hayBusqueda}}
                <p>Todavía no hay categorías registradas.</p>
            {{/hayBusqueda}}
        {{/sinCategorias}}
    </section>
</main>
<dialog id="baja-categoria" class="editor-modal-contenido" aria-labelledby="titulo-baja">
    <div class="editor-modal-icono" aria-hidden="true">!</div>
    <h2 id="titulo-baja">Dar de baja categoría</h2>
    <p>¿Querés dar de baja <strong id="nombre-categoria-baja"></strong>?</p>
    <p class="editor-modal-aclaracion">También se darán de baja sus preguntas. Quienes ya recibieron una podrán responderla.</p>
    <form action="/editor/darDeBajaCategoria" method="post" class="editor-modal-acciones">
        <input type="hidden" name="csrf_token" value="{{tokenBaja}}">
        <input type="hidden" name="categoria_id" id="id-categoria-baja">
        <input type="hidden" name="pagina" value="{{pagina}}">
        <input type="hidden" name="buscar" value="{{buscar}}">
        <button class="editor-modal-cancelar" type="button" autofocus>Cancelar</button>
        <button class="editor-modal-confirmar" type="submit">Dar de baja</button>
    </form>
</dialog>
<script src="/js/editor-gestion-categoria.js?v=paginacion-1" defer></script>
